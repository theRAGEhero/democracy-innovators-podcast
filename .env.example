# Database connection string
DATABASE_URL=file:./runtime/database/payload.db

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=https://stream.democracyinnovators.com

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional archive assistant.
# GEMINI_API_KEY is always required: retrieval embeddings are Gemini regardless
# of which provider writes the answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
CHATBOT_MIN_RETRIEVAL_SCORE=0.22

# Which provider writes the answer: gemini (default) or ollama.
# Ollama Cloud is reached through its OpenAI-compatible endpoint. Get a key at
# ollama.com/settings/keys.
#
# Model id: use the plain catalogue id. The ":cloud"/"-cloud" suffix seen in
# Ollama docs is only for a LOCAL daemon proxying to the cloud — calling
# ollama.com directly, that endpoint already serves cloud models, and the
# suffixed id is rejected. A wrong id surfaces as a 404 from the provider.
#
# OLLAMA_BASE_URL can point at a self-hosted instance instead; both speak the
# same API.
CHATBOT_PROVIDER=gemini
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=https://ollama.com/v1

# Donation address behind the /paypal redirect. Every support link on the site
# points at /paypal, so switching provider means editing this and restarting.
PAYPAL_URL=https://www.paypal.com/ncp/payment/7KCR9XBSCQVMG

# Public Ghost Content API used by npm run sync:ghost
GHOST_ORIGIN=https://democracyinnovators.com
GHOST_CONTENT_KEY=

# Initial Payload administrator email (password is generated locally)
INITIAL_ADMIN_EMAIL=admin@example.com

# Contact form email notifications. Submissions are stored even if SMTP is not configured.
CONTACT_TO_EMAIL=ale@9minuti.it
CONTACT_FROM_EMAIL=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
