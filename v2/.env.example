# Database connection string
DATABASE_URL=file:./v2.db

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=https://stream.democracyinnovators.com

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Optional archive assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public Ghost Content API used by npm run sync:ghost
GHOST_ORIGIN=https://democracyinnovators.com
GHOST_CONTENT_KEY=

# Initial Payload administrator email (password is generated locally)
INITIAL_ADMIN_EMAIL=admin@example.com
