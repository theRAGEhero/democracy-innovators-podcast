{
  "name": "democracy-innovators-podcast",
  "version": "1.0.0",
  "description": "Democracy Innovators Podcast publishing and knowledge platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=2048\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation sh -c 'rm -rf .next && npm run build && npm run start'",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "embeddings:build": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/build-embeddings.ts",
    "episodes:summarize": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/generate-episode-summaries.ts",
    "audio:sync": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-castopod-audio.ts",
    "apikey:create": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/create-api-key.ts",
    "chapters:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-chapters.ts",
    "map:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-map-points.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "profiles:generate": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/generate-guest-extracts.ts",
    "security:check": "git ls-files --cached --others --exclude-standard -z | node scripts/check-secrets.mjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "sync:ghost": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-ghost.ts",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "chapters:castopod": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-castopod-chapters.ts"
  },
  "dependencies": {
    "@libsql/linux-x64-musl": "^0.4.7",
    "@payloadcms/admin-bar": "3.85.1",
    "@payloadcms/db-sqlite": "3.85.1",
    "@payloadcms/live-preview-react": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/plugin-form-builder": "3.85.1",
    "@payloadcms/plugin-nested-docs": "3.85.1",
    "@payloadcms/plugin-redirects": "3.85.1",
    "@payloadcms/plugin-search": "3.85.1",
    "@payloadcms/plugin-seo": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/ui": "3.85.1",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.563.0",
    "next": "16.2.6",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^9.0.1",
    "payload": "3.85.1",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
